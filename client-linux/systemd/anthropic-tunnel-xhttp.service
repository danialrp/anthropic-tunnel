[Unit]
Description=Anthropic tunnel XHTTP transport helper
After=network-online.target
Wants=network-online.target

[Service]
DynamicUser=yes
LoadCredential=config.json:/usr/local/anthropic-tunnel/etc/xhttp.json
ExecStart=/usr/local/anthropic-tunnel/bin/xray run -config %d/config.json
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
