{
  "log": { "level": "info", "timestamp": true },
  "dns": {
    "servers": [ { "type": "local", "tag": "local" } ],
    "final": "local"
  },
  "inbounds": [
    {
      "type": "vless", "tag": "vless-in",
      "listen": "::", "listen_port": 8444,
      "users": [ { "name": "mac", "uuid": "__VLESS_UUID__", "flow": "xtls-rprx-vision" } ],
      "tls": {
        "enabled": true,
        "server_name": "www.apple.com",
        "reality": {
          "enabled": true,
          "handshake": { "server": "www.apple.com", "server_port": 443 },
          "private_key": "__REALITY_KEY__",
          "short_id": ["__REALITY_SHORTID__"],
          "max_time_difference": "1m"
        }
      }
    }
  ],
  "endpoints": [
    {
      "type": "wireguard",
      "tag": "wg-in",
      "system": false,
      "mtu": 1280,
      "address": ["10.66.66.1/24"],
      "private_key": "__WG_SERVER_KEY__",
      "listen_port": 51820,
      "peers": [
        {
          "public_key": "__WG_CLIENT_PUB__",
          "pre_shared_key": "__WG_PSK__",
          "allowed_ips": ["10.66.66.2/32"]
        },
        {
          "public_key": "__WG_LINUX_PUB__",
          "pre_shared_key": "__WG_PSK__",
          "allowed_ips": ["10.66.66.3/32"]
        }
      ]
    }
  ],
  "outbounds": [
    { "type": "direct", "tag": "direct" },
    { "type": "block",  "tag": "block" }
  ],
  "route": {
    "final": "direct",
    "default_domain_resolver": "local"
  }
}
